      "id": "n_0005",
      "name": "Enforce Channel Limits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Truncating at the boundary rather than trusting upstream. Every adapter owns its own\n// platform limits so a factory never has to know them.\nconst CH = JSON.parse($env.MOS_CHANNELS || '{}').linkedin || {};\nconst c = $json.payload.content || {};\nconst fmt = CH.formats?.[$json.payload.format] || CH.formats?.post || {};\nlet body = c.body || '';\nconst tags = (c.hashtags || []).slice(0, fmt.hashtags_max ?? 5);\nlet warn = null;\nif (fmt.max_chars && body.length > fmt.max_chars) { body = body.slice(0, fmt.max_chars - 1); warn = 'truncated_to_channel_limit'; }\nreturn [{ json: { body, hashtags: tags, warn, asset_urls: c.asset_urls || [], alt_text: c.alt_text || null, link: c.link || null, first_comment: c.first_comment || null } }];"
      }
