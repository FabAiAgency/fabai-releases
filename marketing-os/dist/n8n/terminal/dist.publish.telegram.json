        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "headerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"idempotency_key\": \"={{ $('Envelope In').first().json.payload.idempotency_key }}\",\n  \"channel\": \"telegram\",\n  \"external_id\": \"={{ $json.result?.message_id }}\",\n  \"published_at\": \"={{ $now.toISO() }}\",\n  \"trace_id\": \"={{ $('Envelope In').first().json.trace_id }}\"\n}"
