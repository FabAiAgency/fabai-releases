    {
      "id": "n_0020",
      "name": "Envelope In",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GENERATED preamble — every unit in the estate starts here, identically.\n// Rejects an envelope whose MAJOR version this unit does not implement, rather than\n// half-processing a shape it does not understand.\nconst SUPPORTED_MAJOR = 1;\nconst raw = $json.envelope ?? $json;\nconst v = String(raw.envelope_version ?? '0.0.0');\nif (Number(v.split('.')[0]) !== SUPPORTED_MAJOR) {\n  throw new Error('VALIDATION_FAILED: envelope_version ' + v + ' is not supported by media.video.render.before_after@1.0.0 (needs ' + SUPPORTED_MAJOR + '.x)');\n}\nfor (const f of ['trace_id', 'tenant_id', 'idempotency_key']) {\n  if (!raw[f]) throw new Error('VALIDATION_FAILED: envelope.' + f + ' is required');\n}\nif (raw.deadline_at && Date.parse(raw.deadline_at) < Date.now()) {\n  // Fail fast rather than start work that cannot finish in time.\n  throw new Error('TIMEOUT: deadline_at ' + raw.deadline_at + ' already passed before media.video.render.before_after started');\n}\nreturn [{ json: {\n  ...raw,\n  span_id: 'spn_' + Math.random().toString(36).slice(2, 10),\n  parent_span_id: raw.span_id ?? null,\n  policy: raw.policy ?? {},\n  budget: raw.budget ?? {},\n  provenance: raw.provenance ?? [],\n  _started_at: Date.now(),\n  _capability: \"media.video.render.before_after\",\n  _capability_version: \"1.0.0\"\n} }];"
      }
    },
    {
      "id": "n_0021",
      "name": "Span Start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GENERATED telemetry — span_start.\nconst e = $json;\nreturn [{ json: { ...e, _telemetry: {\n  event_id: 'evt_' + Math.random().toString(36).slice(2, 12),\n  trace_id: e.trace_id, span_id: e.span_id, parent_span_id: e.parent_span_id,\n  tenant_id: e.tenant_id, brand_id: e.brand_id ?? null, vertical: e.vertical ?? null,\n  capability: \"media.video.render.before_after\", capability_version: \"1.0.0\",\n  layer: \"terminal\", stage: e.stage ?? null,\n  event: 'span_start', at: new Date().toISOString()\n} } }];"
      }
    },
    {
      "id": "n_0022",
      "name": "Budget Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GENERATED budget guard — injected because media.video.render.before_after declares a cost\n// (estimate 15 minor units). A unit that can spend\n// money never gets to decide for itself whether it may.\nconst ESTIMATE = 15;\nconst e = $json;\nconst b = e.budget ?? {};\nconst cap_ = b.cap_minor_units ?? null;\nconst spent = b.spent_minor_units ?? 0;\nif (cap_ !== null && spent + ESTIMATE > cap_) {\n  throw new Error('BUDGET_EXCEEDED: ' + (spent + ESTIMATE) + ' would exceed cap ' + cap_ + ' in media.video.render.before_after');\n}\nlet tier = e.policy?.model_tier_cap ?? 'frontier';\nconst soft = b.soft_limit_pct ?? 0.8;\nif (cap_ !== null && spent + ESTIMATE > cap_ * soft) {\n  tier = { frontier: 'standard', standard: 'small', small: 'nano', nano: 'nano' }[tier] ?? 'small';\n}\nreturn [{ json: { ...e, policy: { ...(e.policy ?? {}), model_tier_cap: tier }, _budget_reserved: ESTIMATE } }];"
      }
    },
    {
      "id": "n_0001",
      "name": "Build Timeline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Evidence guard. A generated 'after' frame in a proof cut is fabricated evidence — a\n// compliance failure in services and health, not a stylistic choice. The pair must be\n// marked as real captures upstream or this render refuses to run.\nconst pair = $json.payload.evidence_pair;\nif (!pair || pair.generated === true) {\n  throw new Error('COMPLIANCE_BLOCKED: before/after proof requires captured (not generated) frames');\n}\n// The timeline is DATA assembled from parts, not a template with holes punched in it.\n// A missing clip degrades that beat to its still frame rather than failing the render:\n// a video with one static beat ships; a failed render ships nothing.\nconst p = $json.payload;\nconst beats = p.beats || [];\nconst clips = new Map((p.clips || []).map(c => [c.beat_index, c]));\nconst stills = new Map((p.stills || []).map(s => [s.beat_index, s]));\nconst ar = p.aspect_ratio || '9:16';\nconst DIMS = { '9:16': [1080, 1920], '1:1': [1080, 1080], '4:5': [1080, 1350], '16:9': [1920, 1080] };\nconst [width, height] = DIMS[ar] || DIMS['9:16'];\n\nlet t = 0, degraded = 0;\nconst tracks = beats.map((b, i) => {\n  const clip = clips.get(i);\n  const still = stills.get(i);\n  if (!clip) degraded++;\n  const el = {\n    type: clip ? 'video' : 'image',\n    source: clip?.uri || still?.uri || null,\n    time: t,\n    duration: b.duration_s,\n    // A still standing in for a missing clip gets a slow push so the cut still breathes.\n    animations: clip ? [] : [{ type: 'scale', easing: 'linear', start_scale: '100%', end_scale: '108%' }]\n  };\n  t += b.duration_s;\n  return el;\n});\n\nif (tracks.some(x => !x.source)) throw new Error('VALIDATION_FAILED: a beat has neither clip nor still');\n\nreturn [{ json: {\n  output_format: 'mp4', width, height, frame_rate: 30,\n  elements: [\n    ...tracks,\n    p.voiceover_uri ? { type: 'audio', source: p.voiceover_uri, time: 0 } : null,\n    p.music_uri ? { type: 'audio', source: p.music_uri, time: 0, volume: 0.12, audio_fade_out: 1.5 } : null,\n    ...(p.cues || []).map(c => ({ type: 'text', text: c.text, time: c.start_s, duration: Math.max(0.4, c.end_s - c.start_s), ...(p.caption_style || {}) })),\n    p.end_card ? { type: 'composition', source: p.end_card, time: Math.max(0, t - 2.5), duration: 2.5 } : null\n  ].filter(Boolean),\n  total_duration_s: t,\n  degraded_beats: degraded\n} }];"
      }
    },
