      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A before/after is a composition, not a generation: two existing frames placed side by side\n// with a consistent divider and label. Generating an 'after' from an 'before' invents evidence,\n// which in a services or health vertical is a compliance failure, not a creative choice.\nconst p = $('Envelope In').first().json.payload;\nif (!p.before_uri || !p.after_uri) throw new Error('VALIDATION_FAILED: before_uri and after_uri are both required for a proof pair');\nreturn [{ json: { composition: 'side_by_side', before_uri: p.before_uri, after_uri: p.after_uri, divider: 'hairline', labels: ['Before', 'After'], render_via: 'media.video.render', evidence_pair: true } }];"
