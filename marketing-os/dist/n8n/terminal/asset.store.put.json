        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "{\n  \"tenant_id\": \"={{ $('Envelope In').first().json.tenant_id }}\",\n  \"brand_id\": \"={{ $('Envelope In').first().json.brand_id }}\",\n  \"trace_id\": \"={{ $('Envelope In').first().json.trace_id }}\",\n  \"kind\": \"={{ $('Envelope In').first().json.payload.kind }}\",\n  \"role\": \"={{ $('Envelope In').first().json.payload.role || 'raw' }}\",\n  \"storage\": {\n    \"provider\": \"gdrive\",\n    \"uri\": \"={{ $('Upload').first().json.id }}\",\n    \"public_url\": \"={{ $('Make Readable').first().json.webViewLink }}\"\n  },\n  \"media\": {\n    \"checksum_sha256\": \"={{ $('Checksum & Dedupe Key').first().json.checksum_sha256 }}\",\n    \"bytes\": \"={{ $('Checksum & Dedupe Key').first().json.bytes }}\",\n    \"mime\": \"={{ $('Checksum & Dedupe Key').first().json.mime }}\"\n  },\n  \"generation\": {\n    \"prompt\": \"={{ $('Envelope In').first().json.payload.prompt }}\",\n    \"provider\": \"={{ $('Envelope In').first().json.payload.provider }}\"\n  },\n  \"rights\": {\n    \"license\": \"={{ $('Envelope In').first().json.payload.rights_license || 'generated' }}\"\n  },\n  \"taxonomy\": {\n    \"vertical\": \"={{ $('Envelope In').first().json.vertical }}\",\n    \"tags\": \"={{ $('Envelope In').first().json.payload.tags || [] }}\",\n    \"embedding\": \"={{ $('Embed for Search').first().json.data?.[0]?.embedding }}\"\n  },\n  \"derived_from\": \"={{ $('Envelope In').first().json.payload.derived_from || [] }}\"\n}"
