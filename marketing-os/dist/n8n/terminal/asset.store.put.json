    {
      "id": "n_0002",
      "name": "Checksum & Dedupe Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst bin = $binary?.data;\nconst buf = bin ? Buffer.from(bin.data, 'base64') : Buffer.from(JSON.stringify($json.payload || {}));\nconst sum = crypto.createHash('sha256').update(buf).digest('hex');\nreturn [{ json: { checksum_sha256: sum, bytes: buf.length, mime: bin?.mimeType || 'application/octet-stream' } }];"
      }
    },
