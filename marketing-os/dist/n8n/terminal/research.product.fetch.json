    {
      "id": "n_0012",
      "name": "Extract Facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        820
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Everything returned here is marked first_party: true. Downstream copy generation may state\n// a first-party fact plainly; a web finding must be attributed.\nconst raw = $json;\nconst want = $('Envelope In').first().json.payload.extract || null;\nconst facts = [];\n\nif (Array.isArray(raw.reviews)) {\n  const phrases = {};\n  for (const r of raw.reviews) for (const s of String(r.body || '').split(/[.!?]/)) { const t = s.trim().toLowerCase(); if (t.length > 20 && t.length < 120) phrases[t] = (phrases[t] || 0) + 1; }\n  const recurring = Object.entries(phrases).sort((a, b) => b[1] - a[1]).slice(0, 10);\n  facts.push({ kind: 'recurring_customer_language', value: recurring.map(([t, n]) => ({ phrase: t, count: n })), first_party: true });\n  facts.push({ kind: 'review_score', value: (raw.reviews.reduce((a, r) => a + (r.rating || 0), 0) / raw.reviews.length).toFixed(2), sample: raw.reviews.length, first_party: true });\n}\nif (raw.attributes) facts.push({ kind: 'attributes', value: raw.attributes, first_party: true });\nif (raw.specs) facts.push({ kind: 'specifications', value: raw.specs, first_party: true });\nif (raw.account) facts.push({ kind: 'account_context', value: raw.account, first_party: true });\n\nreturn [{ json: { facts, requested: want, source: $('Envelope In').first().json.payload.source || 'catalog', citable_without_attribution: true } }];"
      }
    },
