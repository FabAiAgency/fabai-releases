    {
      "id": "n_0029",
      "name": "Walk Compensations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        2020
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Saga rollback. Walk provenance BACKWARDS and invoke each entry's declared compensation.\n// Entries with no compensation (a delivered Telegram message, a sent email) are reported as\n// irreversible rather than silently skipped — an operator needs to know what is still out there.\nconst env = $('Envelope In').first().json;\nconst REGISTRY = JSON.parse($env.MOS_CAPABILITY_REGISTRY || '{}');\nconst steps = [...(env.provenance || [])].reverse();\nconst toCompensate = [], irreversible = [];\nfor (const s of steps) {\n  const cap = REGISTRY[s.capability];\n  if (!cap) continue;\n  if (['external_write', 'publish', 'spend'].includes(cap.side_effects)) {\n    if (cap.compensation) toCompensate.push({ capability: cap.compensation, for: s.capability, span: s.at });\n    else irreversible.push(s.capability);\n  }\n}\nreturn [{ json: { compensations: toCompensate, irreversible, requires_operator_notice: irreversible.length > 0 } }];"
