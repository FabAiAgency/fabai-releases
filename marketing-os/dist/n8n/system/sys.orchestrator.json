    {
      "id": "n_0010",
      "name": "Dispatch Plan Nodes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        1020
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The plan is a DAG of TAGS. This node walks it, groups independent nodes for parallel\n// execution, and emits one dispatch item per production subsystem. It never names a\n// provider, a platform or a vertical — that is the router's job, one layer down.\nconst plan = $('Compose Plan').first().json;\nconst brief = $('Intake & Understand').first().json;\n\nconst SUBSYSTEM = {\n  'produce.copy.longform': 'sub.content', 'produce.copy.short': 'sub.content', 'produce.script': 'sub.content', 'produce.localize': 'sub.content', 'research.market': 'sub.content', 'research.product': 'sub.content',\n  'produce.image.prompt': 'sub.visual', 'produce.image': 'sub.visual', 'produce.image.edit': 'sub.visual', 'asset.search': 'sub.visual',\n  'produce.video.clip': 'sub.motion', 'produce.audio.vo': 'sub.motion', 'produce.captions': 'sub.motion', 'assemble.video': 'sub.motion',\n  'verify.brand': 'sub.governance', 'verify.compliance': 'sub.governance', 'verify.rights': 'sub.governance', 'approve.human': 'sub.governance',\n  'distribute.publish': 'sub.distribution', 'distribute.schedule': 'sub.distribution',\n  'measure.collect': 'sub.measurement', 'measure.score': 'sub.measurement', 'learn.update': 'sub.measurement'\n};\n\nconst needed = new Set((plan.nodes || []).map(n => SUBSYSTEM[n.tag]).filter(Boolean));\nconst production = ['sub.content', 'sub.visual', 'sub.motion'].filter(s => needed.has(s));\n\nreturn production.map(subsystem => ({ json: {\n  subsystem,\n  brief,\n  plan,\n  channel_allocation: plan.channel_allocation,\n  params: Object.fromEntries((plan.nodes || []).filter(n => SUBSYSTEM[n.tag] === subsystem).map(n => [n.tag, n.params]))\n} }));"
      }
    },
