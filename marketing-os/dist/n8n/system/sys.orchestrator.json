      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Not every run should produce content. A thin brief, no matching play, or an unaffordable\n// plan all end here — visibly, with a reason, rather than by producing something nobody wanted.\nconst reasons = {\n  low_confidence: 'The request was too ambiguous to act on; a clarifying question was sent instead.',\n  no_fit: 'No declared play fits this request. A human needs to either widen the brief or add a play.',\n  budget: 'The plan costs more than this run is allowed to spend.'\n};\nconst r = $json.no_fit ? 'no_fit' : ($json.decision === 'deny' ? 'budget' : 'low_confidence');\nreturn [{ json: { terminal_state: 'declined', reason: r, human_summary: reasons[r], needs_attention: r !== 'low_confidence' } }];"
      }
    },
    {
      "id": "n_0041",
      "name": "Provenance & Span End",
      "type": "n8n-nodes-base.code",
