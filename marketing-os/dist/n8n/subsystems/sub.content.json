    {
      "id": "n_0016",
      "name": "Envelope In",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GENERATED preamble — every unit in the estate starts here, identically.\n// Rejects an envelope whose MAJOR version this unit does not implement, rather than\n// half-processing a shape it does not understand.\nconst SUPPORTED_MAJOR = 1;\nconst raw = $json.envelope ?? $json;\nconst v = String(raw.envelope_version ?? '0.0.0');\nif (Number(v.split('.')[0]) !== SUPPORTED_MAJOR) {\n  throw new Error('VALIDATION_FAILED: envelope_version ' + v + ' is not supported by sub.content@1.0.0 (needs ' + SUPPORTED_MAJOR + '.x)');\n}\nfor (const f of ['trace_id', 'tenant_id', 'idempotency_key']) {\n  if (!raw[f]) throw new Error('VALIDATION_FAILED: envelope.' + f + ' is required');\n}\nif (raw.deadline_at && Date.parse(raw.deadline_at) < Date.now()) {\n  // Fail fast rather than start work that cannot finish in time.\n  throw new Error('TIMEOUT: deadline_at ' + raw.deadline_at + ' already passed before sub.content started');\n}\nreturn [{ json: {\n  ...raw,\n  span_id: 'spn_' + Math.random().toString(36).slice(2, 10),\n  parent_span_id: raw.span_id ?? null,\n  policy: raw.policy ?? {},\n  budget: raw.budget ?? {},\n  provenance: raw.provenance ?? [],\n  _started_at: Date.now(),\n  _capability: \"sub.content\",\n  _capability_version: \"1.0.0\"\n} }];"
      }
    },
    {
      "id": "n_0017",
      "name": "Span Start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GENERATED telemetry — span_start.\nconst e = $json;\nreturn [{ json: { ...e, _telemetry: {\n  event_id: 'evt_' + Math.random().toString(36).slice(2, 12),\n  trace_id: e.trace_id, span_id: e.span_id, parent_span_id: e.parent_span_id,\n  tenant_id: e.tenant_id, brand_id: e.brand_id ?? null, vertical: e.vertical ?? null,\n  capability: \"sub.content\", capability_version: \"1.0.0\",\n  layer: \"subsystem\", stage: e.stage ?? null,\n  event: 'span_start', at: new Date().toISOString()\n} } }];"
      }
    },
    {
      "id": "n_0018",
      "name": "Budget Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// GENERATED budget guard — injected because sub.content declares a cost\n// (estimate 12 minor units). A unit that can spend\n// money never gets to decide for itself whether it may.\nconst ESTIMATE = 12;\nconst e = $json;\nconst b = e.budget ?? {};\nconst cap_ = b.cap_minor_units ?? null;\nconst spent = b.spent_minor_units ?? 0;\nif (cap_ !== null && spent + ESTIMATE > cap_) {\n  throw new Error('BUDGET_EXCEEDED: ' + (spent + ESTIMATE) + ' would exceed cap ' + cap_ + ' in sub.content');\n}\nlet tier = e.policy?.model_tier_cap ?? 'frontier';\nconst soft = b.soft_limit_pct ?? 0.8;\nif (cap_ !== null && spent + ESTIMATE > cap_ * soft) {\n  tier = { frontier: 'standard', standard: 'small', small: 'nano', nano: 'nano' }[tier] ?? 'small';\n}\nreturn [{ json: { ...e, policy: { ...(e.policy ?? {}), model_tier_cap: tier }, _budget_reserved: ESTIMATE } }];"
      }
    },
    {
      "id": "n_0001",
      "name": "Research Needed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Research is not free and not always useful. A product launch from a brief that already\n// contains the facts needs none; a market-commentary piece needs it badly.\nconst b = $json.payload.brief;\nconst hasFacts = (b.offer?.proof || []).length > 0 && (b.message?.key_claims || []).every(c => c.substantiation);\nconst needsMarket = ['awareness', 'demand_gen', 'brand'].includes(b.objective) || (b.message?.angle || '').match(/trend|market|compare|versus|industry/i);\nreturn [{ json: { research: !hasFacts || !!needsMarket, query: `${b.offer?.name} ${b.message?.angle} ${b.audience?.description}`.slice(0, 300) } }];"
      }
    },
