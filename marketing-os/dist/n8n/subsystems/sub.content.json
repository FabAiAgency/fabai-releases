    {
      "id": "n_0005",
      "name": "Plan Copy Slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One long-form anchor if any slot needs it; everything else shards from that anchor so\n// the whole campaign says one consistent thing.\nconst b = $('Envelope In').first().json.payload.brief;\nconst LONG = new Set(['blog', 'email', 'product_listing']);\nconst slots = b.channels || [];\nconst anchorSlot = slots.find(s => LONG.has(s.channel)) || null;\nreturn [{ json: {\n  anchor: anchorSlot,\n  shards: slots.filter(s => s !== anchorSlot),\n  locales: b.constraints?.locales || ['en-US'],\n  total_slots: slots.length\n} }];"
      }
    },
