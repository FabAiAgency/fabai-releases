    {
      "id": "n_0009",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2960,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = $('Score Creative').first().json;\nconst ranked = (s.scored || []).filter(x => x.score != null).sort((a, b) => b.score - a.score);\nreturn [{ json: {\n  period: { to: new Date().toISOString(), window_days: 1 },\n  assets_scored: ranked.length,\n  top: ranked.slice(0, 3).map(x => ({ channel: x.channel, score: Number(x.score.toFixed(3)), confidence: Number(x.confidence.toFixed(2)), impressions: x.impressions })),\n  bottom: ranked.slice(-3).map(x => ({ channel: x.channel, score: Number(x.score.toFixed(3)), impressions: x.impressions })),\n  proposals: $('Propose Playbook Update').first()?.json?.proposals || [],\n  note: s.note || null\n} }];"
      }
    },
