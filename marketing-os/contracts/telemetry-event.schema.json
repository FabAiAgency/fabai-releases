{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabai.dev/mos/contracts/telemetry-event.schema.json",
  "title": "Telemetry Event",
  "description": "One row per span. Emitted to the run ledger (Sheets/warehouse) by every unit. Uniform enough that a single dashboard covers every workflow in the estate, present and future.",
  "type": "object",
  "required": ["event_id", "trace_id", "tenant_id", "capability", "event", "at"],
  "properties": {
    "event_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "span_id": { "type": ["string", "null"] },
    "parent_span_id": { "type": ["string", "null"] },
    "tenant_id": { "type": "string" },
    "brand_id": { "type": ["string", "null"] },
    "vertical": { "type": ["string", "null"] },
    "capability": { "type": "string" },
    "capability_version": { "type": ["string", "null"] },
    "layer": { "type": ["string", "null"], "enum": ["terminal", "subsystem", "system", null] },
    "stage": { "type": ["string", "null"] },
    "event": { "type": "string", "enum": ["span_start", "span_end", "retry", "fallback", "circuit_open", "gate_opened", "gate_blocked", "approval_requested", "approval_resolved", "budget_warning", "budget_exceeded", "compensated", "dlq", "published", "measured"] },
    "status": { "type": ["string", "null"], "enum": ["ok", "error", "skipped", "partial", null] },
    "duration_ms": { "type": ["integer", "null"] },
    "cost_minor_units": { "type": ["number", "null"] },
    "tokens_in": { "type": ["integer", "null"] },
    "tokens_out": { "type": ["integer", "null"] },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "attempt": { "type": ["integer", "null"] },
    "asset_ids": { "type": "array", "items": { "type": "string" } },
    "decision_id": { "type": ["string", "null"] },
    "at": { "type": "string", "format": "date-time" }
  }
}
