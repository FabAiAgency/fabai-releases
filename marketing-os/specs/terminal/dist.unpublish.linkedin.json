{
  "capability": {
    "id": "dist.unpublish.linkedin",
    "version": "1.0.0",
    "layer": "terminal",
    "title": "Unpublish LinkedIn Post",
    "summary": "Compensation for dist.publish.linkedin. Deletes the post and records the reversal against the original trace, so a rolled-back campaign reads as one story in the ledger rather than two unrelated events.",
    "owner": "platform",
    "maturity": "ga",
    "capability_tags": [
      "compensate.distribute.publish"
    ],
    "side_effects": "external_write",
    "idempotent": true,
    "compensation": null,
    "sla": {
      "p50_ms": 800,
      "p95_ms": 4000,
      "timeout_ms": 30000
    },
    "retry": {
      "max_attempts": 5,
      "backoff": "exponential",
      "base_ms": 2000
    },
    "requires": {
      "secrets": [
        "LINKEDIN_OAUTH",
        "MOS_STATE_URL"
      ]
    },
    "verticals": "*",
    "cost_model": {
      "estimate_minor_units": 0
    },
    "observability": {
      "slo": "99.9% — a compensation that fails leaves the system inconsistent, which is worse than the original failure"
    }
  },
  "n8n": {
    "trigger": {
      "kind": "executeWorkflow"
    },
    "nodes": [
      {
        "id": "delete",
        "kind": "http",
        "title": "Delete Post",
        "group": "Compensate",
        "with": {
          "method": "DELETE",
          "url": "https://api.linkedin.com/rest/posts/{{ $json.payload.external_id }}",
          "auth": "oAuth2Api",
          "headers": {
            "X-Restli-Protocol-Version": "2.0.0"
          }
        }
      },
      {
        "id": "record",
        "kind": "http",
        "title": "Record Reversal",
        "group": "Compensate",
        "with": {
          "method": "POST",
          "url": "={{ $env.MOS_STATE_URL }}/publish/reverse",
          "auth": "headerAuth",
          "body": {
            "idempotency_key": "={{ $json.payload.idempotency_key }}",
            "reversed_at": "={{ $now.toISO() }}",
            "reason": "={{ $json.payload.reason }}"
          }
        }
      }
    ]
  }
}
