{
  "capability": {
    "id": "dist.unpublish.blog",
    "version": "1.0.0",
    "layer": "terminal",
    "title": "Unpublish Blog Post",
    "summary": "Compensation for dist.publish.blog. Reverts to draft rather than deleting: a deleted URL that was indexed produces a 404 that outlives the mistake.",
    "owner": "platform",
    "maturity": "ga",
    "capability_tags": [
      "compensate.distribute.publish"
    ],
    "side_effects": "external_write",
    "idempotent": true,
    "compensation": null,
    "sla": {
      "p50_ms": 800,
      "p95_ms": 4000,
      "timeout_ms": 30000
    },
    "retry": {
      "max_attempts": 5,
      "backoff": "exponential",
      "base_ms": 2000
    },
    "requires": {
      "secrets": [
        "CMS_WEBHOOK_URL",
        "MOS_STATE_URL"
      ]
    },
    "verticals": "*",
    "cost_model": {
      "estimate_minor_units": 0
    },
    "observability": {
      "slo": "99.9% — a compensation that fails leaves the system inconsistent, which is worse than the original failure"
    }
  },
  "n8n": {
    "trigger": {
      "kind": "executeWorkflow"
    },
    "nodes": [
      {
        "id": "draft",
        "kind": "http",
        "title": "Revert to Draft",
        "group": "Compensate",
        "with": {
          "method": "PATCH",
          "url": "={{ $env.CMS_WEBHOOK_URL }}/{{ $json.payload.external_id }}",
          "auth": "headerAuth",
          "body": {
            "status": "draft",
            "noindex": true
          }
        }
      },
      {
        "id": "record",
        "kind": "http",
        "title": "Record Reversal",
        "group": "Compensate",
        "with": {
          "method": "POST",
          "url": "={{ $env.MOS_STATE_URL }}/publish/reverse",
          "auth": "headerAuth",
          "body": {
            "idempotency_key": "={{ $json.payload.idempotency_key }}",
            "reversed_at": "={{ $now.toISO() }}"
          }
        }
      }
    ]
  }
}
