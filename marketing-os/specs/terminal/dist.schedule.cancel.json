{
  "capability": {
    "id": "dist.schedule.cancel",
    "version": "1.0.0",
    "layer": "terminal",
    "title": "Cancel Scheduled Publication",
    "summary": "Compensation for dist.schedule.enqueue. Removes a queued item before its slot. The cheapest possible rollback, and the reason scheduling is preferred over immediate publication whenever the brief allows it.",
    "owner": "platform",
    "maturity": "ga",
    "capability_tags": [
      "compensate.distribute.schedule"
    ],
    "side_effects": "external_write",
    "idempotent": true,
    "compensation": null,
    "sla": {
      "p50_ms": 800,
      "p95_ms": 4000,
      "timeout_ms": 30000
    },
    "retry": {
      "max_attempts": 5,
      "backoff": "exponential",
      "base_ms": 2000
    },
    "requires": {
      "secrets": [
        "MOS_STATE_URL"
      ]
    },
    "verticals": "*",
    "cost_model": {
      "estimate_minor_units": 0
    },
    "observability": {
      "slo": "99.9% — a compensation that fails leaves the system inconsistent, which is worse than the original failure"
    }
  },
  "n8n": {
    "trigger": {
      "kind": "executeWorkflow"
    },
    "nodes": [
      {
        "id": "cancel",
        "kind": "http",
        "title": "Cancel",
        "group": "Compensate",
        "with": {
          "method": "DELETE",
          "url": "={{ $env.MOS_STATE_URL }}/schedule/{{ $json.payload.idempotency_key }}",
          "auth": "headerAuth"
        }
      }
    ]
  }
}
