{
  "capability": {
    "id": "learn.playbook.revert",
    "version": "1.0.0",
    "layer": "terminal",
    "title": "Revert Playbook Change",
    "summary": "Compensation for learn.playbook.update. Every accepted profile change is versioned, so reverting is restoring a version — not reconstructing what the profile used to say from memory.",
    "owner": "platform",
    "maturity": "ga",
    "capability_tags": [
      "compensate.learn.update"
    ],
    "side_effects": "external_write",
    "idempotent": true,
    "compensation": null,
    "sla": {
      "p50_ms": 800,
      "p95_ms": 4000,
      "timeout_ms": 30000
    },
    "retry": {
      "max_attempts": 5,
      "backoff": "exponential",
      "base_ms": 2000
    },
    "requires": {
      "secrets": [
        "MOS_STATE_URL"
      ]
    },
    "verticals": "*",
    "cost_model": {
      "estimate_minor_units": 0
    },
    "observability": {
      "slo": "99.9% — a compensation that fails leaves the system inconsistent, which is worse than the original failure"
    }
  },
  "n8n": {
    "trigger": {
      "kind": "executeWorkflow"
    },
    "nodes": [
      {
        "id": "revert",
        "kind": "http",
        "title": "Restore Version",
        "group": "Compensate",
        "with": {
          "method": "POST",
          "url": "={{ $env.MOS_STATE_URL }}/registry/verticals/{{ $json.payload.vertical }}/revert",
          "auth": "headerAuth",
          "body": {
            "to_version": "={{ $json.payload.to_version }}",
            "reason": "={{ $json.payload.reason }}"
          }
        }
      }
    ]
  }
}
